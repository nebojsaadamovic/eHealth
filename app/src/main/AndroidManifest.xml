<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission-sdk-23 android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission-sdk-23 android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission-sdk-23 android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.READ_HEALTH_DATA" />
    <uses-permission android:name="android.permission.WRITE_HEALTH_DATA" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.CAMERA" />


    <application
        android:name="com.example.zdravlje.services.avc.SampleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${icon}"
        android:label="${appName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="${icon}"
        android:supportsRtl="true"
        android:theme="@style/Theme.E_Zdravlje"
        tools:targetApi="31">

        <activity
            android:name="com.example.zdravlje.ui.login.anonimus.AnonimusLoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="hepor.nites.rs"
                    android:pathPrefix="/avc"
                    android:scheme="https" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="hepor.nites.rs"
                    android:pathPrefix="/avc"
                    android:scheme="http" />
            </intent-filter>

        </activity>


        <activity
            android:name="com.example.zdravlje.ui.calendar.options.CalendarOptionsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.calendar.nextOnSchedule.NextOnScheduleActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.chatAudioAndVideoCall.democall2.DemoCallActivity2"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.chatAudioAndVideoCall.DemoCallActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.chatAudioAndVideoCall.CallActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.chat.singleAndGroupMessages.ChatMessagesActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.chat.options.ChatOptionsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.profile.sharedProfile.SharedProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.home.dashboard.event_details.RealisedVisitedDoctorActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.home.dashboard.event_details.RealisedTherapyInPharmacyActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.notification.NotificationActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.home.dashboard.event_details.PersonalDataActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.home.dashboard.event_details.DrugConsumptionActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.home.dashboard.event_details.AvaliableTherapyInPharmacyActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.initialParameter.InitialParametersActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.onBoarding.OnBoardingActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.login.qrCode.QrCodeActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.splash.SplashActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.ui.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name="com.example.zdravlje.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SplashScreen.Zdravlje">
            <meta-data
                android:name="healthdata:linking_scheme"
                android:value="yourappschema" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="rs.e.zdravlje.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="com.example.zdravlje.services.CloudMessagingService"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


