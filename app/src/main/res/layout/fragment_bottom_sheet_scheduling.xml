<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_top_radius"
    tools:context="com.example.zdravlje.ui.chat.scheduleCall.BottomSheetSchedulingFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_header_blue"
        android:paddingStart="15dp"
        android:paddingVertical="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitleHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold_700"
            android:text="@string/fragment_bottom_sheet_scheduling_title_header"
            android:textColor="@color/white"
            android:textSize="@dimen/size_20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/clHeader"
            app:layout_constraintTop_toTopOf="@id/clHeader" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvConfirmDialog"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/roboto_regular_400"
        android:textSize="@dimen/size_15sp"
        android:gravity="center"
        android:text="@string/fragment_bottom_sheet_scheduling_confirm_dialog"
        android:textAlignment="center"
        android:textColor="@color/text_color_3E5764"
        app:layout_constraintStart_toStartOf="@id/clHeader"
        app:layout_constraintTop_toBottomOf="@+id/clHeader" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbCancel"
        style="@style/whiteButton"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginVertical="50dp"
        android:minWidth="160dp"
        android:text="@string/fragment_bottom_sheet_scheduling_cancel"
        android:textSize="15sp"
        app:strokeColor="@color/base_blue_color"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvConfirmDialog"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbYes"
        style="@style/blueButton"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:paddingRight="10dp"
        android:layout_marginEnd="10dp"
        android:text="@string/fragment_bottom_sheet_scheduling_yes"
        android:textSize="15sp"
        android:minWidth="160dp"
        app:layout_constraintTop_toTopOf="@id/mbCancel"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>