            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvChangeMedicaments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_add_permissions_add_btn"
                android:textColor="@color/base_blue_color"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintBottom_toBottomOf="@+id/cbMedicaments"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cbMedicaments" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDateFromToMedicaments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/mtvChangeMedicaments">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvFromMedicaments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto_bold_700"
                    android:text="@string/fragment_add_permissions_from"
                    android:textColor="@color/base_blue_color"
                    android:textSize="@dimen/size_15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvToMedicaments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="100dp"
                    android:fontFamily="@font/roboto_bold_700"
                    android:text="@string/fragment_add_permissions_to"
                    android:textColor="@color/base_blue_color"
                    android:textSize="@dimen/size_15sp"
                    app:layout_constraintBottom_toBottomOf="@+id/mtvFromMedicaments"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/mtvFromMedicaments" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvDateFromMedicaments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/fragment_add_permissions_add_date"
                    android:textColor="@color/base_blue_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/mtvFromMedicaments"
                    app:layout_constraintTop_toBottomOf="@id/mtvFromMedicaments" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvDateToMedicaments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/fragment_add_permissions_add_date"
                    android:textColor="@color/base_blue_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/mtvToMedicaments"
                    app:layout_constraintTop_toBottomOf="@id/mtvToMedicaments" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clEHR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:background="@drawable/bg_white_radius_10"
            android:paddingHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clMedicaments">

            <CheckBox
                android:id="@+id/cbEHR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/checkbox_selector"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_add_permissions_ehr"
                android:textColor="@color/black"
                android:textSize="@dimen/size_15sp"
                app:buttonTint="@color/blue_0270BB"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/clEHR" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvChangeEHR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_add_permissions_add_btn"
                android:visibility="gone"
                android:textColor="@color/base_blue_color"
                android:textSize="@dimen/size_14sp"
