                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/mtvChangeEHR">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvFromEHR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto_bold_700"
                    android:text="@string/fragment_add_permissions_from"
                    android:textColor="@color/base_blue_color"
                    android:textSize="@dimen/size_15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvToEHR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="100dp"
                    android:fontFamily="@font/roboto_bold_700"
                    android:text="@string/fragment_add_permissions_to"
                    android:textColor="@color/base_blue_color"
                    android:textSize="@dimen/size_15sp"
                    app:layout_constraintBottom_toBottomOf="@+id/mtvFromEHR"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/mtvFromEHR" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvDateFromEHR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/fragment_add_permissions_add_date"
                    android:textColor="@color/base_blue_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/mtvFromEHR"
                    app:layout_constraintTop_toBottomOf="@id/mtvFromEHR" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvDateToEHR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/fragment_add_permissions_add_date"
                    android:textColor="@color/base_blue_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/mtvToEHR"
                    app:layout_constraintTop_toBottomOf="@id/mtvToEHR" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clNotes"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_radius_10"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clEHR">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvNotesEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_add_permissions_note"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toEndOf="@id/clNotes"
                app:layout_constraintStart_toStartOf="@id/clNotes"
                app:layout_constraintTop_toTopOf="@+id/clNotes" />

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@null"
                android:gravity="top|start"
                android:maxLength="150"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintBottom_toBottomOf="@id/clNotes"
                app:layout_constraintEnd_toEndOf="@id/clNotes"
                app:layout_constraintStart_toStartOf="@+id/clNotes"
                app:layout_constraintTop_toBottomOf="@id/mtvNotesEdit" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


