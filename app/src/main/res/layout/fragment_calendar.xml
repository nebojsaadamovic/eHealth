<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F6"
    android:orientation="vertical"
    tools:context="com.example.zdravlje.ui.calendar.CalendarFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingTop="15dp"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imageWrapper"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="@color/transparent"
            android:padding="10dp"
            app:cardCornerRadius="100dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/base_blue_color"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/ivUserImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_contact_avatar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_avatar_no_profile_img"
                android:fontFamily="@font/roboto_bold_700"
                android:gravity="center"
                android:text="N1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/size_12sp"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/infoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_calendar_title"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/imageWrapper"
            app:layout_constraintStart_toEndOf="@id/imageWrapper"
            app:layout_constraintTop_toTopOf="@id/imageWrapper" />

        <ImageView
            android:id="@+id/ivFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:padding="5dp"
            android:src="@drawable/ic_filter"
            app:layout_constraintBottom_toBottomOf="@id/ivAdd"
            app:layout_constraintEnd_toStartOf="@id/ivAdd"
            app:layout_constraintTop_toTopOf="@+id/ivNotification" />

        <ImageView
            android:id="@+id/ivAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:padding="5dp"
            android:src="@drawable/ic_plus"
            app:layout_constraintBottom_toBottomOf="@id/infoText"
            app:layout_constraintEnd_toStartOf="@id/ivNotification"
            app:layout_constraintTop_toTopOf="@id/infoText" />

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:src="@drawable/ic_notification"
            app:layout_constraintBottom_toBottomOf="@id/ivAdd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivAdd" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvNotificationCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginBottom="15.5dp"
            android:text="00"
            android:textColor="@color/white"
            android:textSize="@dimen/size_8sp"
            app:layout_constraintBottom_toBottomOf="@+id/ivNotification"
            app:layout_constraintStart_toStartOf="@id/ivNotification"
            app:layout_constraintTop_toTopOf="@id/ivNotification" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_previous_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:src="@drawable/ic_calendar_arrow_left" />

            <TextView
                android:id="@+id/monthTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_16sp" />

            <ImageView
                android:id="@+id/button_next_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:src="@drawable/ic_calendar_arrow_right" />

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back"
                android:visibility="gone" />

        </LinearLayout>

        <GridLayout
            android:id="@+id/week_days_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:columnCount="7"
            android:rowCount="1">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:text="@string/fragment_calendar_day_monday_label"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:text="@string/fragment_calendar_day_tuesday_label"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:text="@string/fragment_calendar_day_wednesday_label"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:text="@string/fragment_calendar_day_thursday_label"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:text="@string/fragment_calendar_day_friday"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:text="@string/fragment_calendar_day_saturday"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center"
                android:text="@string/fragment_calendar_day_sunday"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp" />
        </GridLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/calndar_day_item_shimerin" />

                <include layout="@layout/calendar_day_item_shimerin_two" />

                <include layout="@layout/calndar_day_item_shimerin" />

                <include layout="@layout/calendar_day_item_shimerin_two" />

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/calendar_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>