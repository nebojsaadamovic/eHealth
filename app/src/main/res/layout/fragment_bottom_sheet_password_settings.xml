<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_header_white"
    tools:context="com.example.zdravlje.ui.profile.BottomSheetPasswordSettings">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_header_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTitleHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/base_blue_color"
            android:fontFamily="@font/roboto_bold_700"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="15dp"
            android:text="@string/fragment_bottom_sheet_password_settings_header_title"
            android:textColor="@color/white"
            android:textSize="@dimen/size_20sp"
            app:layout_constraintStart_toStartOf="@id/clHeader"
            app:layout_constraintTop_toTopOf="@id/clHeader" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContentNewPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingRight="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvNewPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:paddingVertical="10dp"
            android:text="@string/fragment_bottom_sheet_password_settings_new_password_label"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/clContentNewPass" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvChangePass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_bottom_sheet_password_settings_change_tv"
            android:textColor="@color/base_blue_color"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintBottom_toBottomOf="@id/mtvNewPass"
            app:layout_constraintEnd_toEndOf="@id/clContentNewPass"
            app:layout_constraintTop_toTopOf="@+id/mtvNewPass" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Unesite novu lozinku"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:visibility="gone"
            android:paddingLeft="5dp"
            android:background="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvNewPass" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/viewOne"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_E6E6E6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clContentNewPass" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clConfirmPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingRight="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clContentNewPass">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvConfirmPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:paddingVertical="10dp"
            android:text="@string/fragment_bottom_sheet_password_settings_confirm_password_label"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/clConfirmPass" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvConfrimPassBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_bottom_sheet_password_settings_confirm_tv"
            android:textColor="@color/base_blue_color"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintBottom_toBottomOf="@id/mtvConfirmPass"
            app:layout_constraintEnd_toEndOf="@id/clConfirmPass"
            app:layout_constraintTop_toTopOf="@+id/mtvConfirmPass" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/fragment_bottom_sheet_password_settings_confirm_password_label"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:visibility="gone"
            android:paddingLeft="5dp"
            android:background="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvConfirmPass" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/viewTwo"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_E6E6E6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clConfirmPass" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clForButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewTwo">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mtvCloseBtn"
            style="@style/whiteButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/fragment_bottom_sheet_password_settings_close_btn"
            app:layout_constraintStart_toStartOf="@id/clForButtons"
            app:layout_constraintTop_toTopOf="@id/clForButtons"
            app:strokeColor="@color/base_blue_color"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mtvSave"
            style="@style/blueButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/fragment_bottom_sheet_password_settings_save_btn"
            app:layout_constraintEnd_toEndOf="@id/clForButtons"
            app:layout_constraintTop_toTopOf="@id/mtvCloseBtn" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>