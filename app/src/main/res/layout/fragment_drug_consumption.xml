<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    android:padding="15dp"
    tools:context="com.example.zdravlje.ui.home.dashboard.event_details_fragments.DrugConsumptionFragment">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingTop="15dp"
        android:paddingRight="15dp"
        android:paddingBottom="15dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/roboto_medium_500"
        android:gravity="right"
        android:text="Sačuvaj"
        android:textColor="@color/base_blue_color"
        android:textSize="@dimen/size_17sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toStartOf="@+id/ivDelete"
        app:layout_constraintStart_toEndOf="@+id/ivBack"
        app:layout_constraintTop_toTopOf="@+id/ivBack" />

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:fontFamily=""
        android:src="@drawable/ic_delete_history"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/mtvSave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtvSave"
        app:tint="@color/red_CF242A" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/dateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/roboto_bold_700"
        android:text="@string/activity_drug_consumption_date_title"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/wrapperTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dateTitle"
        app:strokeColor="@color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingTop="10dp"
            android:paddingEnd="15dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/ivEventIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_medicine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvEventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_bold_700"
                android:maxWidth="260dp"
                android:maxLines="1"
                android:text="@string/activity_drug_consumption_title"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/ivEventIcon"
                app:layout_constraintStart_toEndOf="@id/ivEventIcon"
                app:layout_constraintTop_toTopOf="@id/ivEventIcon" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_drug_consumption_medicament_name_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@id/mtvNameValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvEventTitle" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvNameValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold_700"
                android:text=""
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvTer"
                app:layout_constraintTop_toTopOf="@id/mtvTer" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_drug_consumption_dosage_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/mtvDescValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvNameValue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvDescValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold_700"
                android:text="@string/field_empty_value"
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo"
                app:layout_constraintTop_toTopOf="@id/mtvInfo" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wrapperTop"
        app:strokeColor="@color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingTop="10dp"
            android:paddingEnd="15dp"
            android:paddingBottom="20dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvEventTitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_bold_700"
                android:maxWidth="260dp"
                android:maxLines="1"
                android:text="@string/activity_drug_consumption_taking_time_title"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTer1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_drug_consumption_period_from_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@id/mtvTimeFrom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvEventTitle1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTimeFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:fontFamily="@font/roboto_bold_700"
                android:text=""
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvTer1"
                app:layout_constraintTop_toTopOf="@id/mtvTer1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_drug_consumption_period_to_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@id/mtvTimeFrom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvTimeFrom" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTimeTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold_700"
                android:text="@string/field_empty_value"
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo1"
                app:layout_constraintTop_toTopOf="@id/mtvInfo1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTime1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_drug_consumption_consumption_time_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@id/mtvTimeConsumptionValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvInfo1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTimeConsumptionValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:fontFamily="@font/roboto_bold_700"
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvTime1"
                app:layout_constraintTop_toTopOf="@id/mtvTime1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>