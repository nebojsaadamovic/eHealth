<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    android:padding="20dp"
    tools:context="com.example.zdravlje.ui.chat.options.ChatOptionsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clChatConfigure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAddMember"
            android:layout_width="150dp"
            android:layout_height="84dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/ic_add_contact"
            app:layout_constraintStart_toStartOf="@id/clChatConfigure"
            app:layout_constraintTop_toTopOf="@id/clChatConfigure" />

        <TextView
            android:id="@+id/tvAddContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/fragment_chat_options_add_contact"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_18sp"
            app:layout_constraintEnd_toEndOf="@id/ivAddMember"
            app:layout_constraintStart_toStartOf="@id/ivAddMember"
            app:layout_constraintTop_toBottomOf="@id/ivAddMember" />

        <ImageView
            android:id="@+id/ivCreateChatGroup"
            android:layout_width="150dp"
            android:layout_height="84dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/people"
            app:layout_constraintEnd_toEndOf="@id/clChatConfigure"
            app:layout_constraintTop_toTopOf="@id/ivAddMember" />

        <TextView
            android:id="@+id/tvCreateChatGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/fragment_chat_options_create_chat_group"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_18sp"
            app:layout_constraintEnd_toEndOf="@id/ivCreateChatGroup"
            app:layout_constraintStart_toStartOf="@id/ivCreateChatGroup"
            app:layout_constraintTop_toBottomOf="@id/ivCreateChatGroup" />

        <ImageView
            android:id="@+id/ivScheduleCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:src="@drawable/ic_scheduling"
            app:layout_constraintEnd_toEndOf="@id/ivAddMember"
            app:layout_constraintStart_toStartOf="@id/ivAddMember"
            app:layout_constraintTop_toBottomOf="@id/tvAddContact"
            app:layout_goneMarginTop="70dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/fragment_chat_options_schedule_call"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_18sp"
            app:layout_constraintEnd_toEndOf="@id/ivScheduleCall"
            app:layout_constraintStart_toStartOf="@id/ivScheduleCall"
            app:layout_constraintTop_toBottomOf="@id/ivScheduleCall" />

        <ImageView
            android:id="@+id/ivLinkCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="70dp"
            android:src="@drawable/ic_create_link"
            app:layout_constraintEnd_toEndOf="@id/ivCreateChatGroup"
            app:layout_constraintStart_toStartOf="@id/ivCreateChatGroup"
            app:layout_constraintTop_toBottomOf="@id/tvCreateChatGroup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/fragment_chat_options_link_call"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_18sp"
            app:layout_constraintEnd_toEndOf="@id/ivLinkCall"
            app:layout_constraintStart_toStartOf="@id/ivLinkCall"
            app:layout_constraintTop_toBottomOf="@id/ivLinkCall" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="50dp"
        android:src="@drawable/ic_close_black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>