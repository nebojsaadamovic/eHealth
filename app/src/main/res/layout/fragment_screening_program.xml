<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    android:padding="15dp"
    tools:context="com.example.zdravlje.ui.calendar.screening.CalendarScreeningFragment">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:paddingStart="0dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvCalendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium_500"
        android:padding="5dp"
        android:text="@string/fragment_calendar_screening_calendar_header_title"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_18sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvAppointmentExamination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/roboto_bold_700"
        android:text="Odaberite skrining program"
        android:textColor="@color/blackColor_333333"
        android:textSize="@dimen/size_18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvChooseDr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:fontFamily="@font/roboto_regular_400"
        android:text="@string/fragment_calendar_screening_choose_screening_program_subtitle"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppointmentExamination" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMamografia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_stroke_white_rounded_all_10"
        android:padding="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvChooseDr">

        <ImageView
            android:id="@+id/ivMamografia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:src="@drawable/ic_mamografia"
            app:layout_constraintBottom_toTopOf="@+id/vSeparatorLine"
            app:layout_constraintStart_toStartOf="@id/clMamografia"
            app:layout_constraintTop_toTopOf="@id/clMamografia" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvMamografia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableEnd="@drawable/ic_right_vector"
            android:fontFamily="@font/roboto_bold_700"
            android:paddingHorizontal="15dp"
            android:paddingBottom="10dp"
            android:text="@string/fragment_calendar_screening_mammography"
            android:textColor="@color/base_blue_color"
            android:textSize="@dimen/size_17sp"
            app:layout_constraintBottom_toTopOf="@id/vSeparatorLine"
            app:layout_constraintEnd_toEndOf="@id/clMamografia"
            app:layout_constraintStart_toEndOf="@+id/ivMamografia"
            app:layout_constraintTop_toTopOf="@+id/clMamografia" />

        <View
            android:id="@+id/vSeparatorLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintEnd_toEndOf="@id/clMamografia"
            app:layout_constraintStart_toStartOf="@id/clMamografia"
            app:layout_constraintTop_toBottomOf="@id/tvMamografia" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDescMamografia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_calendar_screening_description_mammography"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_12sp"
            app:layout_constraintEnd_toEndOf="@id/clMamografia"
            app:layout_constraintStart_toStartOf="@id/clMamografia"
            app:layout_constraintTop_toBottomOf="@+id/vSeparatorLine" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRgmScreening"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_stroke_white_rounded_all_10"
        android:padding="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clMamografia">

        <ImageView
            android:id="@+id/ivRgmScreening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:src="@drawable/ic_rgm_screening"
            app:layout_constraintBottom_toTopOf="@+id/vSeparatorLine2"
            app:layout_constraintStart_toStartOf="@id/clRgmScreening"
            app:layout_constraintTop_toTopOf="@id/clRgmScreening" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvRgmScreening"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableEnd="@drawable/ic_right_vector"
            android:fontFamily="@font/roboto_bold_700"
            android:paddingHorizontal="15dp"
            android:paddingBottom="10dp"
            android:text="@string/fragment_calendar_screening_rgm_screening"
            android:textColor="@color/base_blue_color"
            android:textSize="@dimen/size_17sp"
            app:layout_constraintBottom_toTopOf="@id/vSeparatorLine2"
            app:layout_constraintEnd_toEndOf="@id/clRgmScreening"
            app:layout_constraintStart_toEndOf="@+id/ivRgmScreening"
            app:layout_constraintTop_toTopOf="@+id/clRgmScreening" />

        <View
            android:id="@+id/vSeparatorLine2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintEnd_toEndOf="@id/clRgmScreening"
            app:layout_constraintStart_toStartOf="@id/clRgmScreening"
            app:layout_constraintTop_toBottomOf="@id/tvRgmScreening" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDescriptRgmScreenin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_calendar_screening_description_rgm_screening"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_12sp"
            app:layout_constraintEnd_toEndOf="@id/clRgmScreening"
            app:layout_constraintStart_toStartOf="@id/clRgmScreening"
            app:layout_constraintTop_toBottomOf="@+id/vSeparatorLine2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


