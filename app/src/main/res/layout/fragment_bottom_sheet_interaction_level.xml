<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_radius_10"
    android:paddingBottom="50dp"
    tools:context="com.example.zdravlje.ui.healthcare.prevention.interactions.BottomSheetInteractionLevelFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_header_blue"
        android:paddingVertical="10dp"
        android:paddingStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/profileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold_700"
            android:text="@string/fragment_interactions_description_level_interaction"
            android:textColor="@color/white"
            android:textSize="@dimen/size_20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RadioGroup
        android:id="@+id/rgInteractions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <RadioButton
            android:id="@+id/rbNoInteractions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:fontFamily="@font/roboto_medium_500"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:padding="15dp"
            android:paddingStart="@dimen/size_15sp"
            android:text="@string/fragment_interactions_description_no_interaction"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:buttonTint="@color/base_blue_color" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_E9E9E9"
            app:layout_constraintTop_toBottomOf="@id/rbDrugInn" />

        <RadioButton
            android:id="@+id/rbModerateInteraction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:fontFamily="@font/roboto_medium_500"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:padding="15dp"
            android:text="@string/fragment_interactions_description_moderate_interaction"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:buttonTint="@color/base_blue_color" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_E9E9E9"
            app:layout_constraintTop_toBottomOf="@id/rbDrug" />

        <RadioButton
            android:id="@+id/rbSeriousInteraction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:fontFamily="@font/roboto_medium_500"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:padding="15dp"
            android:text="@string/fragment_interactions_description_severe_interaction"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:buttonTint="@color/base_blue_color" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_E9E9E9"
            app:layout_constraintTop_toBottomOf="@id/rbInn" />

    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbClose"
        style="@style/whiteButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/fragment_bottom_sheet_filter_close_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mbSelect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rgInteractions"
        app:strokeColor="@color/base_blue_color"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbSelect"
        style="@style/blueButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/select"
        app:layout_constraintBottom_toBottomOf="@+id/mbClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mbClose"
        app:layout_constraintTop_toTopOf="@+id/mbClose" />

</androidx.constraintlayout.widget.ConstraintLayout>