<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_white_radius_10">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeaderItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gray_top_radis_10"
        android:padding="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvSickLeaveStatusItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_status"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvSickLeaveStatusItemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvSickLeaveStatusItemValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:textAlignment="textEnd"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvSickLeaveStatusItem"
            app:layout_constraintTop_toTopOf="@id/mtvSickLeaveStatusItem" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContentItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clHeaderItem">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvStartDateItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_start_date"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvStartDateItemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvStartDateItemValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:textAlignment="textEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvStartDateItem"
            app:layout_constraintTop_toTopOf="@id/mtvStartDateItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvEndDateItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_end_date"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvEndDateItemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvStartDateItemValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvEndDateItemValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:textAlignment="textEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvEndDateItem"
            app:layout_constraintTop_toTopOf="@id/mtvEndDateItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvNumberOfDaysItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_number_of_days"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvNumberOfDaysItemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvEndDateItemValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvNumberOfDaysItemValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:textAlignment="textEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvNumberOfDaysItem"
            app:layout_constraintTop_toTopOf="@id/mtvNumberOfDaysItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvReasonForSickLeaveItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_reason"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvReasonForSickLeaveItemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvNumberOfDaysItemValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvReasonForSickLeaveItemValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:textAlignment="textEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvReasonForSickLeaveItem"
            app:layout_constraintTop_toTopOf="@id/mtvReasonForSickLeaveItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvDiagnosisCodeAndDescriptionItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_diagnosis_and_description"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvDiagnosisCodeAndDescriptionItemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvReasonForSickLeaveItemValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvDiagnosisCodeAndDescriptionItemValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:textAlignment="textEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvDiagnosisCodeAndDescriptionItem"
            app:layout_constraintTop_toTopOf="@id/mtvDiagnosisCodeAndDescriptionItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTemporaryWorkIncapacityCertificateItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_documents"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvDiagnosisCodeAndDescriptionItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTemporaryWorkIncapacityCertificateItemValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:padding="5dp"
            android:text="@string/item_e_sick_leave_open"
            android:textColor="@color/base_blue_color"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintBottom_toBottomOf="@+id/mtvTemporaryWorkIncapacityCertificateItem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mtvTemporaryWorkIncapacityCertificateItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTemporaryWorkIncapacityReportItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/item_e_sick_leave_temporary_work_incapacity_report"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvTemporaryWorkIncapacityCertificateItemValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTemporaryWorkIncapacityReportItemValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:padding="5dp"
            android:text="@string/item_e_sick_leave_open"
            android:textColor="@color/base_blue_color"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintBottom_toBottomOf="@+id/mtvTemporaryWorkIncapacityReportItem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mtvTemporaryWorkIncapacityReportItem" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:indeterminateTint="@color/base_blue_color"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>