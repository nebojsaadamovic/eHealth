<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_top_radius"
    tools:context="com.example.zdravlje.ui.calendar.nextOnSchedule.BottomSheetConfirmDeleteReminderFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/rounded_header_red"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/roboto_bold_700"
            android:text="@string/fragment_bottom_sheet_confirm_delete_reminder_header_title"
            android:textColor="@color/white"
            android:textSize="@dimen/size_20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/clHeader"
            app:layout_constraintStart_toStartOf="@id/clHeader"
            app:layout_constraintTop_toTopOf="@id/clHeader"
            app:layout_constraintVertical_bias="0.538" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/roboto_regular_400"
        android:text=""
        android:textAlignment="center"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeader" />

    <RadioButton
        android:id="@+id/radioBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="30dp"
        android:buttonTint="@color/base_blue_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mtvDescription" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvRadioText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_regular_400"
        android:text="@string/fragment_bottom_sheet_confirm_delete_reminder_clear_all_reminders_in_row_radioBtn"
        android:textColor="@color/black"
        android:textSize="@dimen/size_13sp"
        app:layout_constraintBottom_toBottomOf="@id/radioBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/radioBtn"
        app:layout_constraintTop_toTopOf="@id/radioBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbClose"
        style="@style/whiteButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="50dp"
        android:text="@string/fragment_bottom_sheet_dialog_confirm_cancel_btn"
        app:strokeColor="@color/base_blue_color"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toStartOf="@+id/mbContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbContinue"
        style="@style/blueButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="50dp"
        android:text="@string/fragment_bottom_sheet_dialog_confirm_continue_btn"
        app:layout_constraintBottom_toBottomOf="@id/mbClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mbClose"
        app:layout_constraintTop_toTopOf="@id/mbClose" />

</androidx.constraintlayout.widget.ConstraintLayout>