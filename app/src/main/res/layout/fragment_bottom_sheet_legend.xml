<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_white_bg"
    tools:context="com.example.zdravlje.ui.healthcare.prescribedlistmedicaments.BottomSheetLegendFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_header_blue"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold_700"
            android:text="@string/fragment_bottomsheet_legend_header"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/mbClose"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_info"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:paddingLeft="5dp"
                android:text="@string/fragment_bottomsheet_legend_info1"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_color_8A8A8D"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo"
                app:layout_constraintTop_toTopOf="@+id/mtvInfo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_tag_color"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mtvInfoValue" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvColor"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                app:cardBackgroundColor="@color/blue_light_D9E1F2"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfoColor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mtvInfoColor" />

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/gray_E9E9E9"
                app:layout_constraintTop_toBottomOf="@id/mcvColor" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_info"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoValue1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:paddingLeft="5dp"
                android:text="@string/fragment_bottomsheet_legend_info2"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_color_8A8A8D"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfo1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo1"
                app:layout_constraintTop_toTopOf="@+id/mtvInfo1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoColor1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_tag_color"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mtvInfoValue1" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvColor1"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                app:cardBackgroundColor="@color/orange_light_FDCEAB"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfoColor1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mtvInfoColor1" />

            <View
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/gray_E9E9E9"
                app:layout_constraintTop_toBottomOf="@id/mcvColor1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_info"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoValue2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:paddingLeft="5dp"
                android:text="@string/fragment_bottomsheet_legend_info3"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_color_8A8A8D"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfo2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo2"
                app:layout_constraintTop_toTopOf="@+id/mtvInfo2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoColor2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_tag_color"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mtvInfoValue2" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvColor2"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                app:cardBackgroundColor="@color/pink_light_F8BABA"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfoColor2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mtvInfoColor2" />

            <View
                android:id="@+id/view2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/gray_E9E9E9"
                app:layout_constraintTop_toBottomOf="@id/mcvColor2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_info"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoValue3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:paddingLeft="5dp"
                android:text="@string/fragment_bottomsheet_legend_info4"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_color_8A8A8D"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfo3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo3"
                app:layout_constraintTop_toTopOf="@+id/mtvInfo3" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoColor3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_tag_color"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mtvInfoValue3" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvColor3"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                app:cardBackgroundColor="@color/yellow_light_FFEBA"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfoColor3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mtvInfoColor3" />

            <View
                android:id="@+id/view3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/gray_E9E9E9"
                app:layout_constraintTop_toBottomOf="@id/mcvColor3" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_info"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view3" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoValue4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:paddingLeft="5dp"
                android:text="@string/fragment_bottomsheet_legend_info5"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_color_8A8A8D"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfo4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo4"
                app:layout_constraintTop_toTopOf="@+id/mtvInfo4" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoColor4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_tag_color"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mtvInfoValue4" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvColor4"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                app:cardBackgroundColor="@color/green_light_C6E0B4"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfoColor4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mtvInfoColor4" />

            <View
                android:id="@+id/view4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/gray_E9E9E9"
                app:layout_constraintTop_toBottomOf="@id/mcvColor4" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfo5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_info"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view4" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoValue5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:paddingLeft="5dp"
                android:text="@string/fragment_bottomsheet_legend_info6"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_color_8A8A8D"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfo5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvInfo5"
                app:layout_constraintTop_toTopOf="@+id/mtvInfo5" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvInfoColor5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/fragment_bottomsheet_legend_tag_color"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mtvInfoValue5" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvColor5"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_marginRight="15dp"
                app:cardBackgroundColor="@color/gray_C5C5C5"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/mtvInfoColor5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mtvInfoColor5" />

            <View
                android:id="@+id/view5"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/gray_E9E9E9"
                app:layout_constraintTop_toBottomOf="@id/mcvColor5" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbClose"
        style="@style/blueButton"
        android:layout_marginBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="160dp"
        android:text="@string/fragment_bottomsheet_legend_close_btn"
        android:textSize="@dimen/size_15sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>