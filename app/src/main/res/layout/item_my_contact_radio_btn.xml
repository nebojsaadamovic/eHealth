<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingTop="15dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvSgcoNameValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:textColor="@color/black"
        android:textSize="@dimen/size_16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvEmailValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:textColor="@color/gray_C4C4C4"
        android:textSize="@dimen/size_15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mtvSgcoNameValue" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:background="@color/white_bg"
        app:layout_constraintTop_toBottomOf="@id/mtvEmailValue" />

    <RadioButton
        android:id="@+id/radioButtonName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonTint="@color/base_blue_color"
        app:layout_constraintBottom_toBottomOf="@id/mtvEmailValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtvSgcoNameValue" />

</androidx.constraintlayout.widget.ConstraintLayout>
