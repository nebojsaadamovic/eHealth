                    android:id="@+id/viewAgeTo"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/gray_E9E9E9"
                    app:layout_constraintTop_toBottomOf="@id/mtvAgeToValue" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvMaxQuantity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto_regular_400"
                    android:text="@string/fagment_medicament_details_info_max_quantity"
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_14sp"
                    app:layout_constraintEnd_toStartOf="@+id/mtvMaxQuantityValue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/viewAgeTo" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvMaxQuantityValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium_500"
                    android:text="N/A"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/text_color_8A8A8D"
                    android:textSize="@dimen/size_14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/mtvMaxQuantity"
                    app:layout_constraintTop_toTopOf="@+id/mtvMaxQuantity" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>