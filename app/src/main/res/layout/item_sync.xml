<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clItemTimeSlot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_white_radius_10">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeaderItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_blue_top_radius_10"
        android:padding="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvHeaderItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/adapter_sync_status_header_title"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/statusColorImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusColorImageView"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:strokeColor="@color/transparent"
            app:cardCornerRadius="50dp"
            app:layout_constraintBottom_toBottomOf="@id/mtvHeaderItem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mtvHeaderItem">

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContentItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeaderItem">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvSystem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/adapter_sync_status_external_system"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvSystemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/clContentItem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvSystemValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="8888"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/mtvSystem"
            app:layout_constraintTop_toTopOf="@id/mtvSystem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvSynhronised"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/adapter_sync_status_synhronization"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvSystemValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvSystemValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvSinkValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="8888"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvSynhronised"
            app:layout_constraintTop_toTopOf="@id/mtvSynhronised" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvDateSink"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/adapter_sync_status_date_synhronization"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@id/mtvDateSinkValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvSinkValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvDateSinkValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="8888"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/mtvDateSink"
            app:layout_constraintTop_toTopOf="@id/mtvDateSink" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTimeSink"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/roboto_regular_400"
            android:text="@string/adapter_sync_status_time_synhronization"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toStartOf="@+id/mtvTimeSinkValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mtvDateSinkValue" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTimeSinkValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="8888"
            android:textAlignment="viewEnd"
            android:textColor="@color/text_color_8A8A8D"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/mtvTimeSink"
            app:layout_constraintTop_toTopOf="@id/mtvTimeSink" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>