<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    tools:context="com.example.zdravlje.ui.home.dashboard.ActivitiesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nextActivities"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:background="@drawable/bg_linear_10dp_radius"
        android:padding="15dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/headerNextOnSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_activities_next_on_schedule_tv"
            android:textColor="@color/blue_1C93BE"
            android:textSize="@dimen/size_16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/gray_E9E9E9"
            app:layout_constraintTop_toBottomOf="@id/headerNextOnSchedule" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/line">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/titleNextOnSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fragment_activities_term_more_activities_tv"
                android:textColor="@color/base_blue_color"
                android:textSize="@dimen/size_18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvEventTimeDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/fragment_activities_event_time_tv"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/titleNextOnSchedule"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/titleNextOnSchedule" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nextActivities">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/event_activity_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nextActivities">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/background_shimmer_gray" />

            <include layout="@layout/item_event_shimmerin" />

            <include layout="@layout/item_event_shimmerin" />

            <include layout="@layout/item_event_shimmerin" />

            <include layout="@layout/item_event_shimmerin" />

            <include layout="@layout/item_event_shimmerin" />

            <include layout="@layout/item_event_shimmerin" />
        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clErrorWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/roboto_black_900"
            android:text="@string/fragment_activities_add_activity_tv"
            android:textColor="@color/black"
            android:textSize="@dimen/size_20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDescDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fragment_activities_date_tv"
            android:textColor="@color/text_color_3E5764"
            android:textSize="@dimen/size_12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dateTextView" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/transparent"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvDescDate">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvMedicine"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/transparent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="15dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivMedicineIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_medicine"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvMedicineEventTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_bold_700"
                        android:maxWidth="260dp"
                        android:maxLines="1"
                        android:text="@string/fragment_activities_medicament_consumation"
                        android:textColor="@color/base_color"
                        android:textSize="@dimen/size_17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivMedicineIcon"
                        app:layout_constraintStart_toEndOf="@id/ivMedicineIcon"
                        app:layout_constraintTop_toTopOf="@id/ivMedicineIcon" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvMedicineEventDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_black_900"
                        android:maxLines="1"
                        android:paddingEnd="10dp"
                        android:text="@string/fragment_activities_medicine_add_medicament"
                        android:textColor="@color/base_blue_color"
                        android:textSize="@dimen/size_17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvAppointment"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mcvMedicine"
                app:strokeColor="@color/transparent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="15dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivAppointmentIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_appointment"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvAppointmentEventTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_black_900"
                        android:maxWidth="260dp"
                        android:maxLines="1"
                        android:text="@string/fragment_activities_doctors_appointment"
                        android:textColor="@color/base_blue_color"
                        android:textSize="@dimen/size_14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivAppointmentIcon"
                        app:layout_constraintStart_toEndOf="@id/ivAppointmentIcon"
                        app:layout_constraintTop_toTopOf="@id/ivAppointmentIcon" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvAppointmentEventDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_black_900"
                        android:maxLines="1"
                        android:paddingEnd="10dp"
                        android:text="@string/fragment_activities_schedule_examination"
                        android:textColor="@color/base_blue_color"
                        android:textSize="@dimen/size_17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvScreening"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mcvAppointment"
                app:strokeColor="@color/transparent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="15dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivScreeningIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_screening"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvScreeningEventTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_black_900"
                        android:maxWidth="260dp"
                        android:maxLines="1"
                        android:text="@string/fragment_activities_appointment_screening_examination"
                        android:textColor="@color/screeningColor"
                        android:textSize="@dimen/size_14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivScreeningIcon"
                        app:layout_constraintStart_toEndOf="@id/ivScreeningIcon"
                        app:layout_constraintTop_toTopOf="@id/ivScreeningIcon" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvScreeningEventDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_black_900"
                        android:maxLines="1"
                        android:paddingEnd="10dp"
                        android:text="@string/fragment_activities_make_appointment"
                        android:textColor="@color/base_blue_color"
                        android:textSize="@dimen/size_18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvActivity"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mcvScreening"
                app:strokeColor="@color/transparent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="15dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivActivityIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_activity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvActivityEventTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_black_900"
                        android:maxWidth="260dp"
                        android:maxLines="1"
                        android:text="@string/fragment_activities_personal_activity"
                        android:textColor="@color/activityColor"
                        android:textSize="@dimen/size_14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivActivityIcon"
                        app:layout_constraintStart_toEndOf="@id/ivActivityIcon"
                        app:layout_constraintTop_toTopOf="@id/ivActivityIcon" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtvActivityEventDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/roboto_black_900"
                        android:maxLines="1"
                        android:paddingEnd="10dp"
                        android:text="@string/fragment_activities_add_activity"
                        android:textColor="@color/base_blue_color"
                        android:textSize="@dimen/size_17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>