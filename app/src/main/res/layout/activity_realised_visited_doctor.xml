<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    android:padding="15dp"
    tools:context="com.example.zdravlje.ui.home.dashboard.event_details.RealisedVisitedDoctorActivity">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingTop="15dp"
        android:paddingRight="15dp"
        android:paddingBottom="15dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvInfoTable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:fontFamily="@font/roboto_medium_500"
        android:text="@string/activity_realised_visited_doctor_header_title"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/activityTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:fontFamily="@font/roboto_medium_500"
        android:text="@string/activity_realised_visited_doctor_date_title"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activityTitle"
        app:strokeColor="@color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingTop="10dp"
            android:paddingEnd="15dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivEventIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_event_realised"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvEventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_medium_500"
                android:maxWidth="260dp"
                android:maxLines="1"
                android:text="@string/activity_realised_visited_doctor_title"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/ivEventIcon"
                app:layout_constraintStart_toEndOf="@id/ivEventIcon"
                app:layout_constraintTop_toTopOf="@id/ivEventIcon" />

            <View
                android:id="@+id/line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/white_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivEventIcon" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_realised_visited_doctor_date_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/mtvDateValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/line" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvDateValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center_vertical|end"
                android:text="@string/activity_realised_visited_doctor_date_value"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvDate"
                app:layout_constraintTop_toTopOf="@id/mtvDate" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvPlace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_realised_visited_doctor_health_institution_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/mtvDateValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvDateValue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvPlaceValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center_vertical|end"
                android:text="@string/activity_realised_visited_doctor_health_institution_value"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvPlace"
                app:layout_constraintTop_toTopOf="@id/mtvPlace" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvPlaceInHospital"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_realised_visited_doctor_place_organizational_unit_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/mtvPlaceValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvPlaceValue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvPlaceInHospitalValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center_vertical|end"
                android:text="@string/activity_realised_visited_doctor_place_organizational_unit_value"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvPlaceInHospital"
                app:layout_constraintTop_toTopOf="@id/mtvPlaceInHospital" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvVisitType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_realised_visited_doctor_visit_type_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/mtvPlaceInHospitalValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvPlaceInHospitalValue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvVisitTypeValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center_vertical|end"
                android:text="@string/activity_realised_visited_doctor_visit_type_value"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvVisitType"
                app:layout_constraintTop_toTopOf="@id/mtvVisitType" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvDoctorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_realised_visited_doctor_doctor_name_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/mtvVisitTypeValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvVisitTypeValue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvDoctorNameValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center_vertical|end"
                android:text="@string/activity_realised_visited_doctor_doctor_name_value"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvDoctorName"
                app:layout_constraintTop_toTopOf="@id/mtvDoctorName" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvMainTypeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/roboto_regular_400"
                android:text="@string/activity_realised_visited_doctor_type_examination"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/mtvDoctorNameValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mtvDoctorNameValue" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvMainTypeValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:gravity="center_vertical|end"
                android:text="@string/activity_realised_visited_doctor_doctor_name_value"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtvMainTypeName"
                app:layout_constraintTop_toTopOf="@id/mtvMainTypeName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>