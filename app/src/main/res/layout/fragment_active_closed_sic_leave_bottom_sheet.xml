<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_radius_10"
    tools:context="com.example.zdravlje.ui.healthcare.esickleave.ActiveClosedSicLeaveBottomSheetFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_header_blue"
        android:paddingVertical="10dp"
        android:paddingStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold_700"
            android:text="@string/fragment_active_closed_sickleave_bottomsheet_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RadioGroup
        android:id="@+id/statusRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/clHeader">

        <RadioButton
            android:id="@+id/rbActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/base_blue_color"
            android:drawablePadding="8dp"
            android:fontFamily="@font/roboto_medium_500"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:padding="15dp"
            android:text="@string/fragment_active_closed_sickleave_bottomsheet_active_sickleave"
            android:textSize="@dimen/size_14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_E9E9E9"
            app:layout_constraintBottom_toBottomOf="@id/personalActivityRadioButton" />

        <RadioButton
            android:id="@+id/rbClosed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/blue_0270BB"
            android:drawablePadding="8dp"
            android:fontFamily="@font/roboto_medium_500"
            android:gravity="center_vertical"
            android:layoutDirection="rtl"
            android:padding="15dp"
            android:text="@string/fragment_active_closed_sickleave_bottomsheet_closed_sickleave"
            android:textSize="@dimen/size_14sp" />

    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbClose"
        style="@style/whiteButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="50dp"
        android:text="@string/fragment_active_closed_sickleave_bottomsheet_close_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mbConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusRadioGroup"
        app:strokeColor="@color/base_blue_color"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbConfirm"
        style="@style/blueButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fragment_active_closed_sickleave_bottomsheet_save_btn"
        app:layout_constraintBottom_toBottomOf="@+id/mbClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mbClose"
        app:layout_constraintTop_toTopOf="@+id/mbClose"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>