<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    android:padding="15dp"
    tools:context="com.example.zdravlje.ui.calendar.personalActivity.CalendarPersonalActivityFragment">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingRight="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvPersonalActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:fontFamily="@font/roboto_bold_700"
        android:text="@string/fragment_calendar_personal_activity_add_personal_activity_title"
        android:textColor="@color/black"
        android:textSize="@dimen/size_18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvAddActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/roboto_regular_400"
        android:text="@string/fragment_calendar_personal_activity_add_activity_subtitle"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPersonalActivity" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clNameActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_stroke_white_rounded_all_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAddActivity">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvNameActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_calendar_personal_activity_name_activity"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintBottom_toBottomOf="@+id/clNameActivity"
            app:layout_constraintEnd_toStartOf="@+id/tvEnterActivity"
            app:layout_constraintStart_toStartOf="@+id/clNameActivity"
            app:layout_constraintTop_toTopOf="@+id/clNameActivity" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvEnterActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:padding="15dp"
            android:text="@string/fragment_calendar_personal_activity_enter_activity_tv"
            android:textColor="@color/base_blue_color"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintBottom_toBottomOf="@id/tvNameActivity"
            app:layout_constraintEnd_toEndOf="@id/clNameActivity"
            app:layout_constraintTop_toTopOf="@+id/tvNameActivity" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbNext"
        style="@style/blueButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="50dp"
        android:alpha="0.2"
        android:enabled="false"
        android:text="@string/fragment_parameters_next_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>




