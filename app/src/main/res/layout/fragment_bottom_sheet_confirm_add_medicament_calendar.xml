<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_white_radius_10"
    tools:context="com.example.zdravlje.ui.calendar.medicament.BottomSheetConfirmAddMedicamentCalendarFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_header_blue"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitleHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:fontFamily="@font/roboto_bold_700"
            android:text="@string/fragment_bottom_sheet_confirm_add_medicament_calendar_header_title"
            android:textColor="@color/white"
            android:textSize="@dimen/size_20sp"
            app:layout_constraintEnd_toEndOf="@+id/clHeader"
            app:layout_constraintStart_toStartOf="@id/clHeader"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvDialogText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fragment_bottom_sheet_confirm_add_medicament_calendar_description"
        android:fontFamily="@font/roboto_regular_400"
        android:textAlignment="center"
        android:layout_marginVertical="30dp"
        android:textSize="@dimen/size_15sp"
        android:textColor="@color/text_color_3E5764"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clHeader"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbCancel"
        style="@style/whiteButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="50dp"
        android:text="@string/fragment_bottom_sheet_confirm_add_medicament_calendar_cancel_btn"
        app:layout_constraintEnd_toStartOf="@+id/mbConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtvDialogText" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbConfirm"
        style="@style/blueButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="50dp"
        android:text="@string/fragment_bottom_sheet_confirm_add_medicament_calendar_confirm_btn"
        app:layout_constraintBottom_toBottomOf="@id/mbCancel"
        app:layout_constraintTop_toTopOf="@id/mbCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mbCancel" />


</androidx.constraintlayout.widget.ConstraintLayout>