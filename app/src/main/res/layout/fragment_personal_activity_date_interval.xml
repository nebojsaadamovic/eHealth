<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    android:padding="15dp"
    tools:context="com.example.zdravlje.ui.calendar.personalActivity.CalendarPersonalActivityFragment">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingRight="10dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvCalendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium_500"
        android:text="@string/fragment_personal_activity_date_interval_header_title"
        android:textColor="@color/text_color_3E5764"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvAddActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/roboto_regular_400"
        android:paddingStart="15dp"
        android:paddingBottom="15dp"
        android:text="@string/fragment_personal_activity_date_details_add_repetition_interval_label"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCalendar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTimeTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_stroke_white_rounded_all_10"
        android:padding="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAddActivity">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvInterval"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_personal_activity_date_interval_add_repetition_interval_label"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDateFromValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:padding="10dp"
            android:text="Unesi"
            android:textColor="@color/base_blue_color"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tvInterval"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvInterval" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTimeFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:text="@string/fragment_personal_activity_date_interval_time_from_label"
            android:textColor="@color/black"
            android:textSize="@dimen/size_14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvInterval" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTimeFromValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_500"
            android:padding="10dp"
            android:text="Unesi"
            android:textColor="@color/base_blue_color"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tvTimeFrom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTimeFrom" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/white_bg"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTimeTo"
        app:strokeColor="@color/gray_E6E6E6_20">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvIActivityName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_personal_activity_date_interval_activity_name_label"
                android:textColor="@color/black"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintEnd_toStartOf="@+id/tvActivityNameValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvActivityNameValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintBottom_toBottomOf="@id/tvIActivityName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvIActivityName"
                app:layout_constraintTop_toTopOf="@+id/tvIActivityName" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvITimeFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_personal_activity_date_interval_period_from_label"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/tvITimeFromValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIActivityName" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvITimeFromValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintBottom_toBottomOf="@id/tvITimeFrom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvITimeFrom"
                app:layout_constraintTop_toTopOf="@+id/tvITimeFrom" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvITimeTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_personal_activity_date_interval_period_to_label"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@+id/tvTimeToValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvITimeFrom" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvTimeToValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:textAlignment="textEnd"
                android:textColor="@color/text_color_8A8A8D"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintBottom_toBottomOf="@id/tvITimeTo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvITimeTo"
                app:layout_constraintTop_toTopOf="@+id/tvITimeTo" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbNext"
        style="@style/blueButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="50dp"
        android:alpha="0.3"
        android:enabled="false"
        android:text="@string/fragment_parameters_next_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>




