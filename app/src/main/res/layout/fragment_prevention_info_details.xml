<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_bg"
    tools:context="com.example.zdravlje.ui.healthcare.prevention.commonsthemes.PreventionInfoDetailsFragment">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingHorizontal="15dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium_500"
        android:text="@string/fragment_prevention_info_details_header"
        android:textColor="@color/text_color_3E5764"
        android:textSize="@dimen/size_18sp"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toEndOf="@+id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <ImageView
        android:id="@+id/ivMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        android:padding="5dp"
        android:src="@drawable/ic_atachment"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/mtvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtvTitle" />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcvText1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:strokeColor="@color/transparent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:padding="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/mtvContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:fontFamily="@font/roboto_regular_400"
                    android:justificationMode="inter_word"
                    android:padding="10dp"
                    android:text="Lorem ipsum dolor si amet, consectaeur elit dornet mas...\n\n
Lorem ipsum dolor sit amet consectetur. Aliquet mauris sagittis tristique turpis ultrices fames posuere volutpat lobortis. Mauris eget tempor suspendisse aliquam senectus commodo leo id amet. Vitae eleifend nunc diam vitae congue amet sit odio volutpat. Volutpat aliquam consectetur ultricies fermentum.\n\nLorem ipsum dolor sit amet consectetur. Aliquet mauris sagittis tristique turpis ultrices fames posuere volutpat lobortis. Mauris eget tempor suspendisse aliquam senectus commodo leo id amet. Vitae eleifend nunc diam vitae congue amet sit odio volutpat. Volutpat aliquam consectetur ultricies fermentum.\n\nLorem ipsum dolor sit amet consectetur. Aliquet mauris sagittis tristique turpis ultrices fames posuere volutpat lobortis. Mauris eget tempor suspendisse aliquam senectus commodo leo id amet. Vitae eleifend nunc diam vitae congue amet sit odio volutpat. Volutpat aliquam consectetur ultricies fermentum."
                    android:textColor="@color/black"
                    android:textSize="@dimen/size_15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>