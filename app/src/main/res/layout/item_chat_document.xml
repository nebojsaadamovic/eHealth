<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="50dp"
    android:paddingTop="5dp"
    android:paddingEnd="20dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/clEating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/glue_CBDEE9"
        app:cardCornerRadius="10dp"
        android:clipToPadding="false"
        android:layout_marginBottom="5dp"
        app:strokeColor="@color/transparent"
        android:outlineAmbientShadowColor="@color/black30"
        android:outlineSpotShadowColor="@color/black30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                android:src="@drawable/ic_chat_document"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSingleMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:fontFamily="@font/roboto_medium_500"
                android:lineHeight="22dp"
                android:text="@string/fragment_item_chat_document_extension"
                android:layout_marginStart="10dp"
                android:textAlignment="textStart"
                android:textColor="@color/text_color_3E5764"
                android:textSize="@dimen/size_14sp"
                app:layout_constraintStart_toEndOf="@id/ivImage"
                app:layout_constraintTop_toTopOf="parent" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/blue_2D9AE4"
                android:clipToPadding="false"
                android:outlineAmbientShadowColor="@color/black30"
                android:outlineSpotShadowColor="@color/black30"
                app:cardCornerRadius="3dp"
                android:layout_marginTop="5dp"
                app:layout_constraintStart_toEndOf="@id/ivImage"
                app:layout_constraintTop_toBottomOf="@+id/tvSingleMessage"
                app:strokeColor="@color/blue_2D9AE4">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="5dp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/roboto_medium_500"
                    android:text="@string/fragment_item_chat_document_file_size"
                    android:textSize="@dimen/size_12sp" />

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:id="@+id/tvTimeReceivedMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium_500"
                android:text="@string/fragment_item_chat_document_time"
                android:textColor="@color/base_color"
                android:textSize="@dimen/size_11sp"
                app:layout_constraintBottom_toBottomOf="@+id/materialCardView"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>